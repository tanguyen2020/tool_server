# Tài khoản đăng nhập dashboard (bắt buộc đổi mật khẩu)
ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-nay

# Khoá bí mật để ký session + mã hoá mật khẩu/private key SSH lưu trong data/servers.json.
# Để trống thì tool tự sinh và lưu vào data/secret.key (nhớ backup cùng servers.json).
APP_SECRET=

HOST=0.0.0.0
PORT=8080

# Đặt true khi chạy sau reverse proxy HTTPS (nginx/caddy/traefik)
COOKIE_SECURE=false
TRUST_PROXY=false

# Chu kỳ lấy số liệu (ms): khi có người xem / khi không ai mở dashboard
POLL_INTERVAL_MS=5000
IDLE_POLL_INTERVAL_MS=30000
